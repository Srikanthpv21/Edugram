NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Either a real Postgres...
# DATABASE_URL=postgres://edugram:edugram@localhost:5432/edugram
# ...or embedded Postgres stored on disk (zero setup):
DATABASE_URL=pglite://./.data/edugram
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-too
WEB_ORIGIN=http://localhost:3000
# Set to true only when the API runs behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# console | msg91
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
